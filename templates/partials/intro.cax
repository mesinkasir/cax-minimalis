<section class="container py-5">
  <div class="row justify-content-center text-center">
    <div class="col-lg-2"></div>
    <div class="col-lg-8 p-5">
      <img class="img-icon mb-3" alt="{{intro.title}}"
      src="{{intro.image}}" loading="lazy" width="40" height="40"/>
      <span class="badge badge-success">{{ intro.description }}</span>
      <h2 class="mt-3"><a href="{{url}}">{{ intro.title }}</a></h2>
      <p class="lead text-muted">{{ intro.text }}</p>
    </div>
    <div class="col-lg-2"></div>
  </div>
</section>