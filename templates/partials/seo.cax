 <title>{{ title or config.title }}</title>
    <meta name="title" content="{{ title or config.title }}">
    <meta name="description" content="{{ description or config.description }}">
    <meta name="author" content="{{ author or metadata.author }}">
    <meta name="robots" content="index, follow">
    <link rel="icon" type="image/png" href="{{ metadata.logo }}">
    <link rel="apple-touch-icon" href="{{ metadata.logo }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ metadata.url }}{{ url }}">
    <meta property="og:title" content="{{ title or config.title }}">
    <meta property="og:description" content="{{ description or config.description }}">
    <meta property="og:image" content="{{ metadata.url }}{{ config.image }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ metadata.url }}">
    <meta name="twitter:title" content="{{ title or config.title }}">
    <meta name="twitter:description" content="{{ description or config.description }}">
    <meta name="twitter:image" content="{{ metadata.url }}{{ config.image }}">
<link rel="canonical" href="{{ metadata.url }}{{ url }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/axcora-css@1.0.1/axcora.min.css">
<link href="{{metadata.url}}/css/style.css" rel="stylesheet">    
<meta name="generator" content="CAX SSG - Static Site Generator in C">
<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "url": "{{ metadata.url }}{{ url }}",
        "name": "{{ title or config.title }}",
        "description": "{{ description or config.description }}",
        "author": {
            "@type": "Person",
            "name": "{{ metadata.author }}"
        },
        "publisher": {
            "@type": "Organization",
            "name": "{{ metadata.author }}",
            "logo": {
                "@type": "ImageObject",
                "url": "{{ metadata.url }}{{ metadata.logo }}"
            }
        },
        "image": {
            "@type": "ImageObject",
            "url": "{{ metadata.url }}{{ config.image }}"
        },
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ metadata.url }}{{ url }}"
        }
    }
    </script>