<section class="container mt-5 p-3">
  <div class="card text-center p-5 rounded-4">
    <div class="card-body">
      <img class="img-icon" 
      src="{{footer.image}}" alt="{{metadata.title}}" loading="lazy" width="40" height="40"/>
      <h3><a href="{{url}}">{{ footer.title }}</a></h3>
      <p>{{ footer.description }}</p>
      <p>{{ footer.text }}</p>
      <div class="mt-4">
        <a href="{{ hero.button1.url }}" class="btn btn-primary">
        {{ hero.button1.text }}</a>
        <a href="{{ hero.button2.url }}" class="btn btn-secondary ms-2">
        {{ hero.button2.text }}
        </a>
      </div>
    </div>
  </div>
</section>